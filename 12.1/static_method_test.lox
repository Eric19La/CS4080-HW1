class Math {
  class square(n) {
    return n * n;
  }
}

print Math.square(3); // Prints "9".

class Counter {
  class create() {
    print this;
    return "created a " + this.label();
  }
  class label() {
    return "Counter";
  }
}

print Counter.create();

// Regular instance methods still work alongside statics.
class Greeter {
  class formalGreeting() {
    return "Good day";
  }
  greet(who) {
    print Greeter.formalGreeting() + ", " + who + "!";
  }
}

var g = Greeter();
g.greet("world");
