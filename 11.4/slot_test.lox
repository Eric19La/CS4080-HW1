// Basic locals 
{
  var a = 1;
  var b = 2;
  var c = a + b;
  print c;
  a = 10;
  print a + b;
}

fun makeCounter() {
  var i = 0;
  return fun () {
    i = i + 1;
    return i;
  };
}
var counter = makeCounter();
print counter();
print counter();
print counter();

// Recursion / function params
fun fact(n) {
  if (n <= 1) return 1;
  return n * fact(n - 1);
}
print fact(5);

// Classes this/super
class Animal {
  speak() {
    print "generic noise";
  }
}

class Dog < Animal {
  speak() {
    super.speak();
    print "woof";
  }
  describe() {
    print this.name;
  }
  init(name) {
    this.name = name;
  }
}

var d = Dog("Rex");
d.speak();
d.describe();

// Globals still work
var g = "global";
print g;
