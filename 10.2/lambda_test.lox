fun thrice(fn) {
  for (var i = 1; i <= 3; i = i + 1) {
    fn(i);
  }
}

thrice(fun (a) {
  print a;
});

fun () {};

fun makeCounter() {
  var i = 0;
  return fun () {
    i = i + 1;
    return i;
  };
}
var counter = makeCounter();
print counter();
print counter();

fun add(a, b) { return a + b; }
print add(1, 2);
